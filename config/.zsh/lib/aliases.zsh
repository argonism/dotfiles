# .zshrc reload
alias re="source ~/.zshrc"

# cd by dir name only for ..
alias ..="cd .."

# git
alias g='git'
alias gs='git status'
alias gdc='git diff --cached'
alias gcm='git commit -m'
alias gk='git checkout'
alias ga='git add'

# python
alias u='UV_ENV_FILE=".env" uv run'

# misc
alias ll='ls -laGh'
