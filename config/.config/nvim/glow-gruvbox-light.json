{
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": "#282828",
    "margin": 2
  },
  "block_quote": {
    "color": "#665c54",
    "indent": 1,
    "indent_token": "│ ",
    "italic": true
  },
  "paragraph": {
    "color": "#282828"
  },
  "list": {
    "level_indent": 2
  },
  "heading": {
    "block_suffix": "\n",
    "color": "#3c3836",
    "bold": true
  },
  "h1": {
    "prefix": "# ",
    "color": "#9d0006",
    "bold": true
  },
  "h2": {
    "prefix": "## ",
    "color": "#af3a03"
  },
  "h3": {
    "prefix": "### ",
    "color": "#79740e"
  },
  "h4": {
    "prefix": "#### ",
    "color": "#427b58"
  },
  "h5": {
    "prefix": "##### ",
    "color": "#076678"
  },
  "h6": {
    "prefix": "###### ",
    "color": "#8f3f71",
    "bold": true
  },
  "text": {
    "color": "#282828"
  },
  "strikethrough": {
    "crossed_out": true
  },
  "emph": {
    "italic": true
  },
  "strong": {
    "bold": true
  },
  "hr": {
    "color": "#665c54",
    "format": "\n--------\n"
  },
  "item": {
    "block_prefix": "• "
  },
  "enumeration": {
    "block_prefix": ". "
  },
  "task": {
    "ticked": "[✓] ",
    "unticked": "[ ] "
  },
  "link": {
    "color": "#076678",
    "underline": true
  },
  "link_text": {
    "color": "#076678",
    "bold": true
  },
  "image": {
    "color": "#8f3f71",
    "underline": true
  },
  "image_text": {
    "color": "#665c54",
    "format": "Image: {{.text}} →"
  },
  "code": {
    "prefix": " ",
    "suffix": " ",
    "color": "#282828",
    "background_color": "#d5c4a1",
    "bold": true
  },
  "code_block": {
    "color": "#282828",
    "margin": 2,
    "chroma": {
      "text": {
        "color": "#282828"
      },
      "error": {
        "color": "#fbf1c7",
        "background_color": "#9d0006"
      },
      "comment": {
        "color": "#665c54",
        "italic": true
      },
      "comment_preproc": {
        "color": "#af3a03"
      },
      "keyword": {
        "color": "#9d0006",
        "bold": true
      },
      "keyword_reserved": {
        "color": "#8f3f71"
      },
      "keyword_namespace": {
        "color": "#b57614"
      },
      "keyword_type": {
        "color": "#076678"
      },
      "operator": {
        "color": "#5f5f00"
      },
      "punctuation": {
        "color": "#665c54"
      },
      "name": {
        "color": "#282828"
      },
      "name_builtin": {
        "color": "#8f3f71"
      },
      "name_tag": {
        "color": "#076678"
      },
      "name_attribute": {
        "color": "#b57614"
      },
      "name_class": {
        "color": "#427b58",
        "underline": true,
        "bold": true
      },
      "name_constant": {
        "color": "#8f3f71"
      },
      "name_decorator": {
        "color": "#b57614"
      },
      "name_function": {
        "color": "#5f5f00"
      },
      "literal_number": {
        "color": "#8f3f71"
      },
      "literal_string": {
        "color": "#5f5f00"
      },
      "literal_string_escape": {
        "color": "#076678"
      },
      "generic_deleted": {
        "color": "#9d0006"
      },
      "generic_emph": {
        "italic": true
      },
      "generic_inserted": {
        "color": "#5f5f00"
      },
      "generic_strong": {
        "bold": true
      },
      "generic_subheading": {
        "color": "#665c54"
      },
      "background": {
        "background_color": "#ebdbb2"
      }
    }
  },
  "table": {
    "color": "#282828"
  },
  "definition_list": {
    "color": "#282828"
  },
  "definition_term": {
    "color": "#282828",
    "bold": true
  },
  "definition_description": {
    "block_prefix": "\n ",
    "color": "#282828"
  },
  "html_block": {
    "color": "#282828"
  },
  "html_span": {
    "color": "#282828"
  }
}
