{
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": "252",
    "margin": 2
  },
  "block_quote": {
    "indent": 1,
    "indent_token": "│ "
  },
  "paragraph": {},
  "list": {
    "level_indent": 2
  },
  "heading": {
    "block_suffix": "\n",
    "color": "39",
    "bold": true
  },
  "h1": {
    "prefix": " ",
    "suffix": " ",
    "color": "228",
    "background_color": "63",
    "bold": true
  },
  "h2": {
    "prefix": "## "
  },
  "h3": {
    "prefix": "### "
  },
  "h4": {
    "prefix": "#### "
  },
  "h5": {
    "prefix": "##### "
  },
  "h6": {
    "prefix": "###### ",
    "color": "35",
    "bold": false
  },
  "text": {},
  "strikethrough": {
    "crossed_out": true
  },
  "emph": {
    "italic": true
  },
  "strong": {
    "bold": true
  },
  "hr": {
    "color": "240",
    "format": "\n--------\n"
  },
  "item": {
    "block_prefix": "• "
  },
  "enumeration": {
    "block_prefix": ". "
  },
  "task": {
    "ticked": "[✓] ",
    "unticked": "[ ] "
  },
  "link": {
    "color": "30",
    "underline": true
  },
  "link_text": {
    "color": "35",
    "bold": true
  },
  "image": {
    "color": "212",
    "underline": true
  },
  "image_text": {
    "color": "243",
    "format": "Image: {{.text}} →"
  },
  "code": {
    "prefix": " ",
    "suffix": " ",
    "color": "203",
    "background_color": "236"
  },
  "code_block": {
    "color": "244",
    "margin": 2,
    "chroma": {
      "text": {
        "color": "#3c3836"
      },
      "error": {
        "color": "#fbf1c7",
        "background_color": "#9d0006"
      },
      "comment": {
        "color": "#665c54",
        "italic": true
      },
      "comment_preproc": {
        "color": "#af3a03"
      },
      "keyword": {
        "color": "#9d0006",
        "bold": true
      },
      "keyword_reserved": {
        "color": "#8f3f71"
      },
      "keyword_namespace": {
        "color": "#b57614"
      },
      "keyword_type": {
        "color": "#076678"
      },
      "operator": {
        "color": "#5f5f00"
      },
      "punctuation": {
        "color": "#665c54"
      },
      "name": {
        "color": "#3c3836"
      },
      "name_builtin": {
        "color": "#8f3f71"
      },
      "name_tag": {
        "color": "#076678"
      },
      "name_attribute": {
        "color": "#b57614"
      },
      "name_class": {
        "color": "#427b58",
        "underline": true,
        "bold": true
      },
      "name_constant": {
        "color": "#8f3f71"
      },
      "name_decorator": {
        "color": "#b57614"
      },
      "name_function": {
        "color": "#5f5f00"
      },
      "literal_number": {
        "color": "#8f3f71"
      },
      "literal_string": {
        "color": "#5f5f00"
      },
      "literal_string_escape": {
        "color": "#076678"
      },
      "generic_deleted": {
        "color": "#9d0006"
      },
      "generic_emph": {
        "italic": true
      },
      "generic_inserted": {
        "color": "#5f5f00"
      },
      "generic_strong": {
        "bold": true
      },
      "generic_subheading": {
        "color": "#665c54"
      },
      "background": {
        "background_color": "#ebdbb2"
      }
    }
  },
  "table": {},
  "definition_list": {},
  "definition_term": {},
  "definition_description": {
    "block_prefix": "\n "
  },
  "html_block": {},
  "html_span": {}
}
